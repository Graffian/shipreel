{
  "name": "shipreel-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "build:shared": "npm run build -w packages/shared-types",
    "build": "npm run build -w packages/shared-types && npm run build -w apps/web",
    "lint": "npm run lint -w apps/web"
  },
  "dependencies": {
    "@google/genai": "^2.0.1"
  }
}
